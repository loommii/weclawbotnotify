syntax = "v1"

info (
	title:    "WeClawBotNotify API"
	desc:     "微信通知推送系统 API"
	version:  "v1"
	author:   "weclawbotnotify"
	schemes:  "http"
	host:     "localhost:48750"
	consumes: "application/json"
	produces: "application/json"
)

// ==================== 通用类型 ====================
// HealthResp 健康检查响应
type HealthResp {
	ServiceName string `json:"service_name"` // 服务名称
	Timestamp   int64  `json:"timestamp"` // 服务器当前时间戳
	Message     string `json:"message"` // 响应消息，e.g. "ok"
}

// PageInfo 分页信息
type PageInfo {
	Page       int   `json:"page"` // 当前页码（从1开始）
	PageSize   int   `json:"page_size"` // 每页条数
	Total      int64 `json:"total"` // 总记录数
	TotalPages int   `json:"total_pages"` // 总页数
}

// ==================== 认证相关 ====================
type (
	// RegisterReq 注册请求
	RegisterReq {
		Username string `json:"username"` // 用户名
		Password string `json:"password"` // 密码
	}
	// UserInfo 用户信息
	UserInfo {
		Id        int64  `json:"id"` // 用户 ID
		Username  string `json:"username"` // 用户名
		CreatedAt string `json:"created_at"` // 创建时间
	}
	// RegisterResp 注册响应
	RegisterResp {
		Token        string   `json:"token"` // Access Token (15分钟过期)
		RefreshToken string   `json:"refresh_token"` // Refresh Token (7天过期)
		User         UserInfo `json:"user"` // 用户信息
	}
	// ProfileResp 用户信息响应
	ProfileResp {
		User UserInfo `json:"user"` // 用户信息
	}
	// LoginReq 登录请求
	LoginReq {
		Username string `json:"username"` // 用户名
		Password string `json:"password"` // 密码
	}
	// LoginResp 登录响应
	LoginResp {
		Token        string   `json:"token"` // Access Token (15分钟过期)
		RefreshToken string   `json:"refresh_token"` // Refresh Token (7天过期)
		User         UserInfo `json:"user"` // 用户信息
	}
	// RefreshReq 刷新令牌请求
	RefreshReq {
		RefreshToken string `json:"refresh_token"` // Refresh Token
	}
	// RefreshResp 刷新令牌响应
	RefreshResp {
		Token        string `json:"token"` // 新的 Access Token
		RefreshToken string `json:"refresh_token"` // 新的 Refresh Token (轮换)
	}
)

// ==================== 用户相关 ====================
type (
	// ChangePasswordReq 修改密码请求
	ChangePasswordReq {
		OldPassword string `json:"old_password"` // 旧密码
		NewPassword string `json:"new_password"` // 新密码
	}
	// ChangePasswordResp 修改密码响应
	ChangePasswordResp  {}
)

// ==================== Client 相关 ====================
type (
	// CreateClientReq 创建客户端请求
	CreateClientReq {
		Name string `json:"name"` // 客户端名称
	}
	// CreateClientResp 创建客户端响应
	CreateClientResp {
		ClientId  int64  `json:"client_id"` // 客户端 ID
		QrcodeUrl string `json:"qrcode_url"` // 二维码链接
	}
	// PollClientStatusReq 轮询客户端状态请求
	PollClientStatusReq {
		ClientId int64 `form:"client_id"` // 客户端 ID
	}
	// PollClientStatusResp 轮询客户端状态响应
	PollClientStatusResp {
		Status      string `json:"status"` // 状态：pending/connected/disconnected
		IlinkUserId string `json:"ilink_user_id,optional"` // iLink 用户 ID（连接后返回）
	}
	// DeleteClientReq 删除客户端请求
	DeleteClientReq {
		Id int64 `path:"id"` // 客户端 ID
	}
	// DeleteClientResp 删除客户端响应
	DeleteClientResp  {}
	// ClientInfo 客户端信息
	ClientInfo {
		Id          int64  `json:"id"` // 客户端 ID
		Name        string `json:"name"` // 客户端名称
		Status      string `json:"status"` // 状态
		IlinkUserId string `json:"ilink_user_id,optional"` // iLink 用户 ID
		CreatedAt   string `json:"created_at"` // 创建时间
	}
	// ListClientsReq 客户端列表请求
	ListClientsReq {
		Page     int `form:"page,default=1"` // 页码，默认 1
		PageSize int `form:"page_size,default=20"` // 每页条数，默认 20
	}
	// ListClientsResp 客户端列表响应
	ListClientsResp {
		PageInfo PageInfo     `json:"page_info"` // 分页信息
		List     []ClientInfo `json:"list"` // 客户端列表
	}
)

// ==================== Application 相关 ====================
type (
	// CreateApplicationReq 创建应用请求
	CreateApplicationReq {
		Name        string `json:"name"` // 应用名称
		Description string `json:"description,optional"` // 应用描述
	}
	// CreateApplicationResp 创建应用响应
	CreateApplicationResp {
		Id        int64  `json:"id"` // 应用 ID
		Token     string `json:"token"` // 应用 Token（用于推送鉴权）
		Name      string `json:"name"` // 应用名称
		CreatedAt string `json:"created_at"` // 创建时间
	}
	// ApplicationInfo 应用信息
	ApplicationInfo {
		Id          int64  `json:"id"` // 应用 ID
		Name        string `json:"name"` // 应用名称
		Description string `json:"description"` // 应用描述
		CreatedAt   string `json:"created_at"` // 创建时间
		LastUsedAt  string `json:"last_used_at,optional"` // 最后使用时间
	}
	// ListApplicationsReq 应用列表请求
	ListApplicationsReq {
		Page     int `form:"page,default=1"` // 页码，默认 1
		PageSize int `form:"page_size,default=20"` // 每页条数，默认 20
	}
	// ListApplicationsResp 应用列表响应
	ListApplicationsResp {
		PageInfo PageInfo          `json:"page_info"` // 分页信息
		List     []ApplicationInfo `json:"list"` // 应用列表
	}
	// DeleteApplicationReq 删除应用请求
	DeleteApplicationReq {
		Id int64 `path:"id"` // 应用 ID
	}
	// DeleteApplicationResp 删除应用响应
	DeleteApplicationResp  {}
)

// ==================== Message 相关 ====================
type (
	// CreateMessageReq 创建消息请求（推送通知）
	CreateMessageReq {
		AppToken string `json:"app_token"` // 应用 Token（用于推送鉴权）
		Title    string `json:"title,optional"` // 消息标题
		Message  string `json:"message"` // 消息内容
		Priority int32  `json:"priority,optional"` // 优先级
	}
	// CreateMessageResp 创建消息响应
	CreateMessageResp {
		Id       int64  `json:"id"` // 消息 ID
		Title    string `json:"title"` // 消息标题
		Message  string `json:"message"` // 消息内容
		Priority int32  `json:"priority"` // 优先级
		Date     string `json:"date"` // 消息日期
	}
	// ListMessagesReq 消息列表请求
	ListMessagesReq {
		Limit int64 `form:"limit,default=20"` // 每页数量，默认 20
		Since int64 `form:"since,optional"` // 游标，返回此 ID 之前的消息
	}
	// MessageInfo 消息信息
	MessageInfo {
		Id            int64  `json:"id"` // 消息 ID
		ApplicationId int64  `json:"application_id"` // 所属应用 ID
		Title         string `json:"title"` // 消息标题
		Message       string `json:"message"` // 消息内容
		Priority      int32  `json:"priority"` // 优先级
		Date          string `json:"date"` // 消息日期
	}
	// ListMessagesResp 消息列表响应
	ListMessagesResp {
		List []MessageInfo `json:"list"` // 消息列表
	}
	// DeleteMessageReq 删除消息请求
	DeleteMessageReq {
		Id int64 `path:"id"` // 消息 ID
	}
	// DeleteMessageResp 删除消息响应
	DeleteMessageResp  {}
)

// ==================== 路由分组 ====================
// 认证（公开，无需鉴权）
@server (
	prefix: /api/auth
	group:  auth
	tags:   "认证"
)
service weclawbotnotify-api {
	@handler Register
	post /register (RegisterReq) returns (RegisterResp)

	@handler Login
	post /login (LoginReq) returns (LoginResp)

	@handler Refresh
	post /refresh (RefreshReq) returns (RefreshResp)
}

// 用户（ClientAuth 鉴权）
@server (
	prefix:     /api/user
	group:      user
	middleware: ClientAuth
	tags:       "用户"
)
service weclawbotnotify-api {
	@handler GetProfile
	get /profile returns (ProfileResp)

	@handler ChangePassword
	post /password (ChangePasswordReq) returns (ChangePasswordResp)
}

// Client 管理（ClientAuth 鉴权）
@server (
	prefix:     /api/client
	group:      client
	middleware: ClientAuth
	tags:       "客户端管理"
)
service weclawbotnotify-api {
	@handler CreateClient
	post /create (CreateClientReq) returns (CreateClientResp)

	@handler PollClientStatus
	get /status (PollClientStatusReq) returns (PollClientStatusResp)

	@handler ListClients
	get /list (ListClientsReq) returns (ListClientsResp)

	@handler DeleteClient
	delete /:id (DeleteClientReq) returns (DeleteClientResp)
}

// Application 管理（ClientAuth 鉴权）
@server (
	prefix:     /api/application
	group:      application
	middleware: ClientAuth
	tags:       "应用管理"
)
service weclawbotnotify-api {
	@handler CreateApplication
	post /create (CreateApplicationReq) returns (CreateApplicationResp)

	@handler ListApplications
	get /list (ListApplicationsReq) returns (ListApplicationsResp)

	@handler DeleteApplication
	delete /:id (DeleteApplicationReq) returns (DeleteApplicationResp)
}

// 消息管理（ClientAuth 鉴权 - 查看历史/删除）
@server (
	prefix:     /api/message
	group:      message
	middleware: ClientAuth
	tags:       "消息管理"
)
service weclawbotnotify-api {
	@handler ListMessages
	get /list (ListMessagesReq) returns (ListMessagesResp)

	@handler DeleteMessage
	delete /:id (DeleteMessageReq) returns (DeleteMessageResp)
}

// 推送 API（外部系统推送通知，app_token 在 body 中传递）
@server (
	prefix: /api/message
	group:  message
	tags:   "消息推送"
)
service weclawbotnotify-api {
	@handler CreateMessage
	post /push (CreateMessageReq) returns (CreateMessageResp)
}

// 健康检查（无需鉴权）
@server (
	prefix: /api
	group:  health
	tags:   "健康检查"
)
service weclawbotnotify-api {
	@handler Health
	get /health returns (HealthResp)
}

