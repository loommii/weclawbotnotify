@startuml WeClawBotNotify_LoginSequence

title WeClawBotNotify V1 - 用户登录序列图\n(双令牌认证)

actor "用户" as User
participant "Web 管理后台\n(浏览器)" as Web
participant "server/HTTPServer" as API
participant "middleware/ClientAuth" as ClientAuth
participant "auth/AccountService" as AccountSvc
participant "jwtx/JWTHelper" as JWTHelper
participant "model/RefreshTokenModel" as RTModel
participant "SQLite" as DB

User -> Web : 输入用户名和密码\n点击"登录"
activate Web

Web -> API : POST /api/auth/login\n{ username, password }
activate API

API -> AccountSvc : login(username, password)
activate AccountSvc

AccountSvc -> DB : SELECT * FROM users\nWHERE username = ?
activate DB
DB --> AccountSvc : User
deactivate DB

AccountSvc -> AccountSvc : checkPassword(password, hash)

alt 密码错误
  AccountSvc --> API : error: LoginPasswordWrong
  API --> Web : 401 { code: 110202, msg: "用户名或密码错误" }
  Web --> User : 提示"用户名或密码错误"
else 密码正确

  AccountSvc -> JWTHelper : generateAccessToken(\n  JWTClaims{UID, TokenType=access, JTI}\n)
  activate JWTHelper
  JWTHelper --> AccountSvc : accessToken (短有效期)
  deactivate JWTHelper

  AccountSvc -> JWTHelper : generateRefreshToken(\n  JWTClaims{UID, TokenType=refresh, JTI}\n)
  activate JWTHelper
  JWTHelper --> AccountSvc : refreshToken (长有效期)
  deactivate JWTHelper

  AccountSvc -> RTModel : insert(ctx, &RefreshToken{\n  userId, jti, revoked=0, expiresAt\n})
  activate RTModel
  RTModel -> DB : INSERT INTO refresh_tokens\n(user_id, jti, revoked, expires_at)\nVALUES (?, ?, 0, ?)
  activate DB
  DB --> RTModel : OK
  deactivate DB
  RTModel --> AccountSvc : nil
  deactivate RTModel

  AccountSvc --> API : TokenPair {\n  accessToken, refreshToken\n}
  deactivate AccountSvc

  API --> Web : 200 OK\n{\n  token: accessToken,\n  refreshToken: refreshToken,\n  user: { id, username }\n}
  deactivate API

  Web -> Web : 存储 accessToken\n和 refreshToken\n到 localStorage

  Web --> User : 登录成功\n跳转到 Dashboard
  deactivate Web

  note over User, DB
    前端存储策略：
    - accessToken: 用于日常API请求
    - refreshToken: 仅在accessToken过期时使用
    - 前端拦截器检测401 → 自动调用 /auth/refresh
  end note

end

@enduml
